# Copy to .env and adjust. Never commit .env.

# --- Database / queue (docker compose, non-default ports to avoid clashes) ---
LA_DATABASE_URL=postgresql+asyncpg://localapply:localapply@localhost:5433/localapply
LA_REDIS_URL=redis://localhost:6380/0

# --- Safety ---
# DRY_RUN=true means SUBMIT actions are logged and simulated, never actually clicked.
# Leave this true until you have watched a full run end to end.
LA_DRY_RUN=true
LA_MAX_ACTIONS_PER_RUN=120
LA_MIN_DECISION_CONFIDENCE=0.60

# --- Browser ---
LA_HEADLESS=false
LA_BROWSER_TIMEOUT_MS=15000
LA_MAX_BROWSER_SESSIONS=3

# --- AI ---
# stub = scripted deterministic reasoner (walking skeleton). ollama = local models (Phase 4).
LA_REASONER=stub
LA_OLLAMA_BASE_URL=http://localhost:11434
LA_VRAM_BUDGET_MB=8151

# --- Paths ---
LA_DATA_DIR=./var
